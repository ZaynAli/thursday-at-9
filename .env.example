# Supabase — Project Settings → API
# https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — server actions / data layer (never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only — magic links, invite URLs (set on Vercel without NEXT_PUBLIC_ prefix)
SITE_URL=http://localhost:3000

# Used by `npm run auth:link -- … --production` (ignored when URL is localhost)
PRODUCTION_SITE_URL=https://thursday-at-9.vercel.app

# Legacy fallback — prefer SITE_URL above
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "true" to force mock data even when Supabase is configured
# NEXT_PUBLIC_USE_MOCK_DATA=true

# Playwright — optional Supabase sign-in test (e2e/auth.spec.ts)
# PLAYWRIGHT_TEST_EMAIL=your@email.com
# PLAYWRIGHT_USE_MOCK=false
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
# PLAYWRIGHT_CHANNEL=chrome
